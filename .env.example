# Optional direct provider configuration. Leave all unset for offline memory.
# Set the key in your shell; this server does not load .env files automatically.
# Example Google Gemini OpenAI-compatible endpoint:
MIND_LAYER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MIND_LAYER_API_KEY=
MIND_LAYER_CHAT_MODEL=gemini-2.5-flash
MIND_LAYER_EMBEDDING_MODEL=gemini-embedding-001
# Optional owner token; required (32+ characters) for non-loopback binding.
MIND_LAYER_TOKEN=
